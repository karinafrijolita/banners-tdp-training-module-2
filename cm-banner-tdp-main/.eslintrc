{
  "extends": ["google"],
  "parser": "@babel/eslint-parser",
  "ignorePatterns": ["node_modules/"],
  "env": {
    "browser": true,
    "jquery": true,
    "node": true
  },
  "rules": {
    "max-len": ["error", { "code": 300 }],
    "no-tabs": ["error", { "allowIndentationTabs": true }],
    "require-jsdoc": "off",
    "valid-jsdoc": "off",
    "indent": ["error", 2],
    "object-curly-spacing": ["error", "always"],
    "eol-last": ["error", "always"]
  }
}
